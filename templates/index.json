    "custom_liquid_wYPdQN": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div style=\"background-color: #f9f9f9; padding: 40px 20px; margin-top: 50px; text-align: center; border-radius: 8px;\">\n  <h3 style=\"margin-bottom: 20px; font-family: var(--font-heading-family); font-size: 1.5rem;\">\n    L'Artisanat Français pour votre Bébé\n  </h3>\n  <p style=\"margin-bottom: 30px; max-width: 100%; margin-left: auto; margin-right: auto;\">\n    Vous avez aimé cet article ? Découvrez mes créations uniques, cousues main en Occitanie pour le confort des tout-petits.\n  </p>\n  \n  <div style=\"display: flex; flex-wrap: wrap; justify-content: center; gap: 15px;\">\n    <a href=\"/collections/vetements-bebe-fille\" style=\"text-decoration: none; border: 1px solid #333; padding: 12px 25px; color: #333; font-weight: bold; border-radius: 4px; transition: all 0.3s;\">\n      Collection Fille\n    </a>\n    \n    <a href=\"/collections/vetements-bebe-garcon\" style=\"text-decoration: none; border: 1px solid #333; padding: 12px 25px; color: #333; font-weight: bold; border-radius: 4px; transition: all 0.3s;\">\n      Collection Garçon\n    </a>\n    \n    <a href=\"/collections/accessoires\" style=\"text-decoration: none; background-color: #333; color: #fff; padding: 12px 25px; font-weight: bold; border-radius: 4px; transition: all 0.3s;\">\n      Idées Cadeaux\n    </a>\n  </div>\n</div>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "rich_text_mUiL8J": {
      "type": "rich-text",
      "blocks": {
        "heading_Y4x93h": {
          "type": "heading",
          "settings": {
            "heading": "L'Excellence du Fait-Main pour vos Vêtements Bébé Fille & Garçon",
            "heading_size": "h2"
          }
        },
        "text_pMWK4c": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Créatrice de Mode Bébé Française (Livraison Nationale)</strong><br/>Bienvenue chez Léa Moulin Couture. Depuis mon atelier en Occitanie, je confectionne des tenues uniques qui voyagent <strong>dans toute la France</strong>. Que vous cherchiez un <strong>vêtement bébé fille</strong> bohème ou un ensemble <strong>vêtement bébé garçon</strong> chic, chaque pièce est réalisée à la commande ou en petite série, garantissant une exclusivité que vous ne trouverez pas en grande surface.</p><p><strong>Le Dressing Idéal : Du trousseau de naissance au 3 ans</strong><br/>Ma collection est pensée pour sublimer chaque étape.</p><ul><li><strong>Pour les filles :</strong> Craquez pour une robe qui tourne, une blouse en gaze de coton ou un beguin fleuri.</li><li><strong>Pour les garçons :</strong> Découvrez nos salopettes intemporelles, sarouels confortables et gilets de berger.</li><li><strong>Le Mixte :</strong> La plupart de mes créations sont conçues pour se transmettre entre frères et sœurs, une approche durable et économique de la mode enfantine.</li></ul><p><strong>Qualité Oeko-Tex et Confort Absolu</strong><br/>Au-delà du style, je privilégie le bien-être. Tous mes tissus sont certifiés <strong>Oeko-Tex Standard 100</strong>. C'est l'assurance d'un vêtement sain, doux et résistant. Offrir une création Léa Moulin, c'est offrir le savoir-faire français en <strong>cadeau de naissance</strong>, livré directement chez vous ou chez les heureux parents, partout en France.</p>"
          }
        },
        "button_WN4xTr": {
          "type": "button",
          "settings": {
            "button_label": "Découvrir",
            "button_link": "shopify://pages/a-propos-atelier",
